<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<android.opengl.GLSurfaceView android:id="@+id/surfaceview" android:layout_width="match_parent" android:layout_height="match_parent"/>
<TextView android:layout_width="32dp" android:layout_height="32dp" android:layout_centerInParent="true" android:text="+" android:gravity="center" android:textSize="24sp" android:textColor="#FFFFFF" android:shadowColor="#000000" android:shadowRadius="3" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:orientation="vertical" android:background="#D0101820"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/return_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Заврши тест" android:textSize="10sp"/><Button android:id="@+id/reset_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Ресет" android:textSize="10sp"/><Button android:id="@+id/depth_button" android:layout_width="0dp" android:layout_weight="2" android:layout_height="52dp" android:text="Заклањање: ДА" android:textSize="10sp"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/mode_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Камера" android:textSize="10sp"/><Button android:id="@+id/collect_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Преузми избор" android:textSize="10sp"/><Button android:id="@+id/sample_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Снимци: 10 s" android:textSize="10sp"/></LinearLayout><TextView android:id="@+id/available_crystals" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Преостало: 5/5 дијаманата" android:textSize="15sp" android:textStyle="bold" android:textColor="#FFF0BE" android:gravity="center"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Празно место: постави · дијамант: сакупи" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:orientation="vertical" android:background="#D0101820" android:padding="6dp">
<TextView android:id="@+id/diagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:textColor="#F0BD69" android:textSize="11sp" android:text="Полако помери телефон да препозна површину."/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/log_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Лог: пун" android:textSize="10sp"/><Button android:id="@+id/mark_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Обележи проблем" android:textSize="10sp"/><Button android:id="@+id/share_button" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Подели дијагностику" android:textSize="10sp"/></LinearLayout></LinearLayout></RelativeLayout>