  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4a18dcb900b4754bb23c2b0400a39ed, type: 3}
  m_Name: MID GAME Dialog
  m_EditorClassIdentifier: 
  assetID: midgame_dialog
  lines:
  - speakerName: Profesor Vlada
    text: "Lepo je \u0161to si ve\u0107 zakora\u010Dio u svet pozori\u0161ne umetnosti
      i otkrio bogatstvo kulturnih doga\u0111anja u Somboru."
    voiceOver: {fileID: 0}
    choices: []
    nextOnChoice0: {fileID: 0}
    nextOnChoice1: {fileID: 0}
    triggerGlitch: 0
    glitchPattern: []
    glitchDuration: 0
  - speakerName: Profesor Vlada
    text: "Sada te pozivam da krene\u0161 glavnom ulicom grada, gde te pod vedrim
      nebom o\u010Dekuje jo\u0161 jedan sloj vizuelnih \u010Duda."
    voiceOver: {fileID: 0}
    choices: []
    nextOnChoice0: {fileID: 0}
    nextOnChoice1: {fileID: 0}
    triggerGlitch: 0
    glitchPattern: []
    glitchDuration: 0
  - speakerName: Profesor Vlada
    text: "Pogledi prolaznika zastaju nad kamenom scenografijom i portretima velikana
      somborske umetnosti, koji su nekada inspiraciju pronalazili na tim istim plo\u010Dnicima."
    voiceOver: {fileID: 0}
    choices: []
    nextOnChoice0: {fileID: 0}
    nextOnChoice1: {fileID: 0}
    triggerGlitch: 0
    glitchPattern: []
    glitchDuration: 0
  - speakerName: Profesor Vlada
    text: "Otvori o\u010Di i srce, jer upravo ovde, na otvorenom teatru grada, tradicija
      i inspiracija postaju jedno."
    voiceOver: {fileID: 0}
    choices: []
    nextOnChoice0: {fileID: 0}
    nextOnChoice1: {fileID: 0}
    triggerGlitch: 0
    glitchPattern: []
    glitchDuration: 0
