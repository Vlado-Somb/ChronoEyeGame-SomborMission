.hint-title {
    font-size: 32px;
    color: white;
    opacity: 0.8;
    letter-spacing: 1px;
    margin-bottom: 5px;
    text-align: center;
}

.hint-text {
    font-size: 46px;
    color: white;
    background-color: rgba(0, 0, 0, 0);
    padding: 10px 20px;
    border-radius: 8px;
    unity-text-align: middle-center;
    max-width: 80%;
    white-space: normal;
    text-align: center;
    -unity-text-outline-width: 1px;
}

.hint-container {
    position: absolute;
    width: 100%;
    height: 20%;
    justify-content: center;
    align-items: center;
    display: flex;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.4);
    pointer-events: none;
}
