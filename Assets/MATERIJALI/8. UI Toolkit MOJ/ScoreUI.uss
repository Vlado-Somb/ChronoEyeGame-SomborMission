.score-ui-root {
    flex-direction: column;
    align-items: center;
    padding: 8px;
    position: absolute;
    top: 25%;
    left: auto;
    width: auto;
    align-self: center;
}

.score-panel {
    flex-direction: column;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    padding: 6px 10px;
    border-radius: 4px;
    width: auto;
}

.toast-label {
    background-color: rgba(0, 0, 0, 0.75);
    color: rgb(255, 255, 255);
    font-size: 28px;
    padding: 4px 6px;
    border-radius: 3px;
    -unity-text-align: middle-center;
    width: 100%;
    position: absolute;
}

.score-toast-new-points {
    font-size: 40px;
    color: yellow;
    unity-font-style: bold;
    margin-bottom: 4px;
    color: rgb(255, 234, 0);
}

.score-title {
    font-size: 32px;
    color: rgb(255, 255, 255);
    margin-right: 8px;

}

.score-value {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);

}
