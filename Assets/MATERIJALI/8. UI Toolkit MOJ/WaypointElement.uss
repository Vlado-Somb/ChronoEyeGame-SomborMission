.waypoint-wrapper {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    background-size: 100% 100%;
    position: absolute;
}

.label-container {
    position: relative;
    bottom: 5px;
    background-color: rgba(0, 0, 0, 0.75);
    padding: 3px 3px;
    border-radius: 3px;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 230px;
    min-width: 40px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
}

.waypoint-label {
    font-size: 16px;
    unity-font-style: bold;
    color: white;
    white-space: nowrap;
    text-align: center;
    margin-top: 0;
    margin-bottom: 0;
}

.waypoint-icon {
    width: 24px;
    height: 24px;
    background-image: resource('pin-icon');
    background-size: cover;
}

.waypoint-selected {
    border-color: yellow;
    border-width: 3px;
    border-radius: 2px;
}

.waypoint-icon.waypoint-selected {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: yellow;
    border-right-color: yellow;
    border-bottom-color: yellow;
    border-left-color: yellow;
    border-radius: 10%;
}

.waypoint-label.waypoint-selected {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: yellow;
    border-right-color: yellow;
    border-bottom-color: yellow;
    border-left-color: yellow;
    border-radius: 10%;
    background-color: rgb(51, 51, 51);
    color: white;
}

.waypoint-completed {
    opacity: 0.5;
    filter: grayscale(1);
}