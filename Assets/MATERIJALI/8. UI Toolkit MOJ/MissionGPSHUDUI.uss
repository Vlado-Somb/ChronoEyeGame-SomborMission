.gps-hud-container {
    flex-direction: column;
    padding: 12px;
    margin: 8px;
    max-width: none;
    align-self: center;
    background-color: rgb(17, 17, 17);
    border-width: 3px;
    border-color: rgb(255, 215, 0);
    border-radius: 6px;
    position: absolute;
    top: 5%;
    left: 5%;
    right: 5%;
}

.gps-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.gps-label {
    font-size: 24px;
    color: rgb(255, 253, 0);
    margin-right: 6px;
}

.gps-value {
    font-size: 24px;
    color: rgb(255, 254, 0);
    -unity-text-align: middle-left;
    flex-grow: 1;
    align-self: center;
}
