#MapRoot {
    justify-content: flex-end;
    align-items: center;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

#MapImage {
    max-width: 90%;
    max-height: 90%;
    border-width: 4px;
    border-color: rgb(68, 68, 68);
    border-radius: 12px;
    align-self: center;
    overflow: hidden;
    bottom: 100px;
}

#WaypointContainer {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: visible;

}
