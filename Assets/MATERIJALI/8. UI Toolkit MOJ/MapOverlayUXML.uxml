<engine:UXML xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MATERIJALI/8.%20UI%20Toolkit%20MOJ/MapOverlayUSS.uss?fileID=7433441132597879392&amp;guid=f76fef742b8b892498a0e343dcefc75d&amp;type=3#MapOverlayUSS" />
    <engine:VisualElement name="MapRoot" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; align-self: center;">
        <engine:VisualElement name="MapImage" style="position: relative; width: 100%; height: 100%; background-size: cover; background-position: center; align-self: center;">
            <engine:VisualElement name="PlayerMarker" style="position: absolute; width: 32px; height: 32px; background-size: cover;" />
            <engine:VisualElement name="WaypointContainer" style="position: absolute; width: 100%; height: 100%;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
