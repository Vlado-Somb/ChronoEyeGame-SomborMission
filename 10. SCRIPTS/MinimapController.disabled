using UnityEngine;
using UnityEngine.UI;
using UnityEngine.UIElements;
using System.Collections.Generic;

public class MinimapController : MonoBehaviour
{
    [Header("References")]
    public Transform arCameraTransform;
    public RectTransform minimapContent;
    public RectTransform minimapRoot;
    public GameObject playerIconPrefab;
    public GameObject waypointIconPrefab;

    [Header("Settings")]
    public float zoom = 50f; // Meters per minimap width
    public float mapSizePixels = 400f; // Width of the minimap in pixels (must match UI size)

    [Header("GPS")]
    [SerializeField] private MonoBehaviour gpsProviderSource;
    private IGpsProvider gps => gpsProviderSource as IGpsProvider;

    private GameObject playerIconInstance;
    private Dictionary<string, GameObject> waypointIcons = new();

    private WaypointDatabase waypointDatabase;

    void Start()
    {
        var wm = FindFirstObjectByType<WaypointManager>();
        waypointDatabase = wm?.GetWaypointDatabase();

        if (gps == null || waypointDatabase == null)
        {
            Debug.LogWarning("[MinimapController] Missing GPS or WaypointDatabase");
            enabled = false;
            return;
        }

        // Instantiate player icon
        playerIconInstance = Instantiate(playerIconPrefab, minimapContent);

        // Create icons for all waypoints
        foreach (var wp in waypointDatabase.waypoints)
        {
            var icon = Instantiate(waypointIconPrefab, minimapContent);
            icon.name = "WP_" + wp.id;
            waypointIcons[wp.id] = icon;
        }
    }

    void Update()
    {
        if (gps == null) return;

        Vector2 center = new Vector2((float)gps.Latitude, (float)gps.Longitude);

        // Position player icon at center
        playerIconInstance.GetComponent<RectTransform>().anchoredPosition = Vector2.zero;

        foreach (var wp in waypointDatabase.waypoints)
        {
            Vector2 offsetMeters = LatLonToMetersOffset(center, new Vector2((float)wp.latitude, (float)wp.longitude));
            Vector2 scaled = offsetMeters * (mapSizePixels / zoom);
            if (waypointIcons.TryGetValue(wp.id, out var icon))
            {
                icon.GetComponent<RectTransform>().anchoredPosition = scaled;
            }
        }

        // Rotate map with camera pitch
        float pitch = arCameraTransform.eulerAngles.x;
        pitch = pitch > 180f ? pitch - 360f : pitch;
        minimapRoot.localRotation = Quaternion.Euler(pitch, 0, 0);
    }

    Vector2 LatLonToMetersOffset(Vector2 origin, Vector2 target)
    {
        float dx = WaypointManager.HaversineDistance(origin.x, origin.y, origin.x, target.y);
        float dy = WaypointManager.HaversineDistance(origin.x, origin.y, target.x, origin.y);
        dx *= Mathf.Sign(target.y - origin.y);
        dy *= Mathf.Sign(target.x - origin.x);
        return new Vector2(dx, dy);
    }

    public void ToggleMinimap() => minimapRoot.gameObject.SetActive(!minimapRoot.gameObject.activeSelf);
    public void ZoomIn() => zoom = Mathf.Max(10f, zoom - 10f);
    public void ZoomOut() => zoom = Mathf.Min(200f, zoom + 10f);

    public void SetActiveWaypoints(List<string> activeIds)
    {
        foreach (var pair in waypointIcons)
        {
            bool shouldShow = activeIds.Contains(pair.Key);
            pair.Value.SetActive(shouldShow);
        }
    }
}
