  skipSceneName: 3_ACT0_Embassy_2
  nextSceneName: 3_ACT0_Embassy_2
  textUI: {fileID: 892512695}
  textChunks:
  - 'FIRST MISSION DATA FILE

    Locate the former Serbian Embassy.'
  - "\u2022 Geo-lock reference: 47\xB029'30.9\"N 19\xB003'31.1\"E"
  - "\u2022 Task: Scan the fa\xE7ades of surrounding buildings and nearby museums;
    confirm their precise positions."
  - "\u2022 Purpose: These coordinates will be triangulated to validate the embassy\u2019s
    true location amid shifting records."
  - "The streets remember more than they show. Map the silent sentinels around you\u2014each
    confirmed landmark strengthens our signal."
  - "The streets remember more than they show. Map the silent sentinels around you\u2014each
    confirmed landmark strengthens our signal.\n\nTransmit your scans when ready.\n\u2014
    D.A.C.C. (Digital Archive Command Ceneter)"
  fadeDuration: 0.8
  displayDuration: 5
