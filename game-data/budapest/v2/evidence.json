  "historyCards": [
    {
      "id": "BP2_HISTORY_0",
      "text": "Разликуј приказ и доказ; фикционални увод не успоставља стварну историјску чињеницу.",
      "sourceIds": [
        "SRC_USER_CORE"
      ]
    },
    {
      "id": "BP2_HISTORY_1",
      "text": "Амбасада је стварна станица; Дучићев драматизовани говор није историјски снимак или аутентичан цитат.",
      "sourceIds": [
        "SRC_EMBASSY",
        "SRC_USER_CORE"
      ]
    },
    {
      "id": "BP2_HISTORY_2",
      "text": "Трг хероја је стварно место; борба два лика за холограм је фикција.",
      "sourceIds": [
        "SRC_HEROES",
        "SRC_USER_CORE"
      ]
    },
    {
      "id": "BP2_HISTORY_3",
      "text": "Званични историјат наводи отварање 1887. и стварне књижевне кругове; не доказује наш дијалог.",
      "sourceIds": [
        "SRC_CENTRAL",
        "SRC_USER_CORE"
      ]
    },
    {
      "id": "BP2_HISTORY_4",
      "text": "Витковићева кућа је одвојена од Текелијанума; тајно чланство и поздрав су фикција.",
      "sourceIds": [
        "SRC_TEKELIJANUM",
        "SRC_VITKOVICS_SALON",
        "SRC_USER_CORE"
      ]
    },
    {
      "id": "BP2_HISTORY_5",
      "text": "КУД Табан не чува доказану тајну шифру из османског доба. Храм није сада физички присутан.",
      "sourceIds": [
        "SRC_TABAN_OSZK",
        "SRC_KUD_TABAN",
        "SRC_USER_CORE"
      ]
    },
    {
      "id": "BP2_HISTORY_6",
      "text": "Простор и историја храма морају бити проверени; AR реконструкција је разлучива од историјског доказа.",
      "sourceIds": [
        "SRC_TABAN_OSZK",
        "SRC_TABAN_BTM",
        "SRC_USER_PHOTO"
      ]
    }
  ],
